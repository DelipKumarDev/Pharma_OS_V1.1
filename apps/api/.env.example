# ─── Server ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pharmaos?schema=public"

# ─── JWT — generate unique secrets per deployment! ──────────────────────
# PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# Linux/Mac:  openssl rand -base64 48
JWT_SECRET=CHANGE-ME-generate-a-long-random-secret
JWT_REFRESH_SECRET=CHANGE-ME-generate-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ───────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://your-pharmacy-domain.com

# ─── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=5

# ─── File Uploads / Backups / Logs ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
BACKUP_DIR=backups
LOG_DIR=logs
LOG_LEVEL=info

# ─── Email (OTP + stock/expiry alerts) ──────────────────────────────────
# Gmail: use an App Password (myaccount.google.com/apppasswords)
# Or use AWS SES / Zoho / any SMTP relay
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PharmaOS <noreply@your-pharmacy-domain.com>

# ─── SMS / WhatsApp (refill reminders + alerts) ─────────────────────────
# SMS_PROVIDER=msg91           # msg91 | twilio (unset = disabled)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=PHRMOS       # 6-char DLT-approved sender ID
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+91xxxxxxxxxx    # or whatsapp:+91xxxxxxxxxx
